# ReBid AI - Environment Configuration Template
# Copy this file to .env before starting the server:
# Windows: copy .env.example .env
# Linux/macOS: cp .env.example .env

# Security & Authentication
SECRET_KEY=rebid-ai-enterprise-procurement-jwt-secret-key-2026-prod-hash
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./rebid.db

# Email Service (Optional)
# If left blank, OTP codes will be printed directly to the backend terminal console.
# To send real emails, get a free API key from https://resend.com
RESEND_API_KEY=
