# ReBid AI - Environment Configuration Template
# Copy this file to .env before starting the server:
# Windows: copy .env.example .env
# Linux/macOS: cp .env.example .env

# Security & Authentication
SECRET_KEY=rebid-ai-enterprise-procurement-jwt-secret-key-2026-prod-hash
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./rebid.db

# Email Service (Optional)
# If nothing below is set, OTP codes will be printed directly to the backend terminal console.
#
# Option A: SMTP (free, no third-party API key needed) — checked first if SMTP_HOST is set.
# For Gmail: enable 2-Step Verification on the Google Account, then create an
# "App Password" at https://myaccount.google.com/apppasswords and use that as SMTP_PASSWORD
# (your normal Gmail password will NOT work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Option B: Resend (fallback if SMTP is not configured)
# Get a free API key from https://resend.com
RESEND_API_KEY=
